{
  "name": "gsnv-paint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node dev/prepare-planegcs.mjs",
    "prepare:solver": "node dev/prepare-planegcs.mjs",
    "test:solver-types": "tsc --ignoreConfig --noEmit --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --module NodeNext --moduleResolution NodeNext --types node node_modules/@salusoft89/planegcs/dist/index.d.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:launcher": "node launcher/start.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:spec": "python3 dev/verify-spec.py",
    "start": "node launcher/start.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:browser": "npm run build && playwright test",
    "test:deploy": "npm run build && wrangler deploy --dry-run --no-autoconfig"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.160.1"
  },
  "dependencies": {
    "@salusoft89/planegcs": "1.3.0",
    "libraw-wasm": "1.6.0",
    "replicad-opencascadejs": "1.2.1",
    "three": "0.187.0"
  }
}
